    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>BibleTimeline.Api</RootNamespace>
    <AssemblyName>BibleTimeline.Api</AssemblyName>
