# El gateway queda únicamente en loopback. Cloudflare Tunnel (ioda-admin) termina TLS y enruta
# cada hostname configurado abajo a http://localhost:7310.
HOST_BIND=127.0.0.1
GATEWAY_PORT=7310
CADDY_CONFIG=prod

POSTGRES_DB=bible_timeline
POSTGRES_USER=bible_timeline
POSTGRES_PASSWORD=<generate-a-long-unique-password>

ASPNETCORE_ENV=Production
ADMIN_JWT_SECRET=<generate-at-least-32-random-characters>
NOTES_JWT_SECRET=<generate-at-least-32-random-characters>
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_TOKEN=
SEED_DEVELOPMENT_ADMIN=false

# Public web and API hostnames. Create matching proxied Tunnel CNAME records in active zones of
# the same Cloudflare account as ioda-admin, plus the matching cloudflared ingress routes.
PUBLIC_WEB_HOST=chrono.llamado.de
API_HOST=chrono-api.pixcan.com
NOTES_API_HOST=chrono-notes-api.pixcan.com
CONTENT_API_HOST=chrono-content-api.pixcan.com
ADMIN_WEB_HOST=chrono-admin.pixcan.com
ADMIN_API_HOST=chrono-admin-api.pixcan.com
FRONTEND_BASE_URL=https://chrono.llamado.de
CONTENT_API_ALLOWED_ORIGINS=https://chrono.llamado.de,https://chrono-admin.pixcan.com
CONTENT_ADMIN_ALLOWED_ORIGINS=https://chrono-admin.pixcan.com

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
