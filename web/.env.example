# Copia este archivo como .env.local y ajusta los valores.
# Vite solo expone variables con prefijo VITE_ al cliente.

# URL base del API. En desarrollo Vite proxea /api → localhost:5080,
# por lo que esta variable solo es necesaria si el API corre en otro host/puerto.
# VITE_API_BASE=http://localhost:5080

# Social login — get these from Google Cloud Console and Meta Developers
# https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# https://developers.facebook.com/apps
# VITE_FACEBOOK_APP_ID=your-app-id
