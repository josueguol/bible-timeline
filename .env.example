# ── Runtime environment ───────────────────────────────────────────────────────
# Production (default) enforces startup guards: no default postgres password,
# no placeholder JWT secrets, HTTPS FrontendBaseUrl. Set to Development ONLY
# for a local stack.
ASPNETCORE_ENV=Production

# ── Database connection strings ───────────────────────────────────────────────
# PostgreSQL is managed externally — set the full connection string for each API.
CONTENT_API_DB=Host=<host>;Port=5432;Database=bible_timeline;Username=<user>;Password=<password>
CONTENT_ADMIN_DB=Host=<host>;Port=5432;Database=bible_timeline;Username=<user>;Password=<password>
NOTES_API_DB=Host=<host>;Port=5432;Database=bible_timeline;Username=<user>;Password=<password>

# ── JWT secrets — generate with: openssl rand -base64 32 ─────────────────────
ADMIN_JWT_SECRET=<openssl-rand-base64-32>
NOTES_JWT_SECRET=<openssl-rand-base64-32>

# ── One-time admin setup ──────────────────────────────────────────────────────
# Keep disabled in production unless creating the first admin user.
ADMIN_SETUP_ENABLED=false
ADMIN_SETUP_TOKEN=<temporary-setup-token>

# ── Optional CORS allowlists ──────────────────────────────────────────────────
# Leave blank when APIs are only reached through the same-origin reverse proxy.
CONTENT_API_ALLOWED_ORIGINS=
CONTENT_ADMIN_ALLOWED_ORIGINS=

# ── OAuth providers (notes-api) ───────────────────────────────────────────────
# Leave blank to disable the corresponding social login.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Absolute HTTPS URL used for OAuth redirects in production.
FRONTEND_BASE_URL=https://example.com
