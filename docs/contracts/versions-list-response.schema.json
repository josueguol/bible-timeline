{
  "$comment": "Shape of GET /api/bible/versions. Returns the catalog of Bible versions available for reading and comparison.",
  "type": "object",
  "required": ["versions"],
  "properties": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["versionId", "code", "title", "language", "isPrimary"],
        "properties": {
          "versionId": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 2, "maxLength": 16 },
          "languageFamily": {
            "type": "string",
            "enum": ["es", "original-hebrew", "original-greek", "other"]
          },
          "isPrimary": { "type": "boolean" },
          "verseCount": { "type": "integer", "minimum": 1 },
          "sourcePath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
