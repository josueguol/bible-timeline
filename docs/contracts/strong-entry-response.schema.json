{
  "$comment": "Shape of GET /api/strongs/{strongNumber}. Returns one Strong dictionary entry.",
  "type": "object",
  "required": [
    "strongNumber",
    "language",
    "lemma",
    "definition",
    "definitionLanguage",
    "translationStatus",
    "source"
  ],
  "properties": {
    "strongNumber": { "type": "string", "pattern": "^[GH][0-9]+$" },
    "language": { "type": "string", "enum": ["hebrew", "greek"] },
    "lemma": { "type": "string", "minLength": 1 },
    "transliteration": { "type": "string" },
    "pronunciation": { "type": "string" },
    "definition": { "type": "string" },
    "derivation": { "type": "string" },
    "kjvDefinition": { "type": "string" },
    "definitionLanguage": { "type": "string", "enum": ["es", "en"] },
    "translationStatus": {
      "type": "string",
      "enum": ["source", "machine", "reviewed", "fallback"]
    },
    "source": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
