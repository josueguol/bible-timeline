{
  "$comment": "Query parameters of GET /api/search.",
  "type": "object",
  "required": ["q"],
  "properties": {
    "q": { "type": "string", "minLength": 1, "maxLength": 256 },
    "versionId": { "type": "string", "minLength": 1 },
    "timelineId": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["reference", "event", "text"] }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
  },
  "additionalProperties": false
}
