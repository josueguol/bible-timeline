{
  "$comment": "Shape of GET /api/bible/verses. Returns verses aligned by sequence across 1..3 versions.",
  "type": "object",
  "required": ["manifestId", "versions", "rows"],
  "properties": {
    "manifestId": { "type": "string", "minLength": 1 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "range": {
      "type": "object",
      "required": ["fromSequence", "toSequence"],
      "properties": {
        "fromSequence": { "type": "integer", "minimum": 1 },
        "toSequence": { "type": "integer", "minimum": 1 },
        "fromRef": { "type": "string", "minLength": 1 },
        "toRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence", "ref", "book", "chapter", "verse", "texts"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "book": { "type": "string", "minLength": 1 },
          "chapter": { "type": "integer", "minimum": 1 },
          "verse": { "type": "integer", "minimum": 1 },
          "texts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": ["string", "null"] }
          },
          "segments": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["position", "text", "strongs"],
                "properties": {
                  "position": { "type": "integer", "minimum": 1 },
                  "text": { "type": "string", "minLength": 1 },
                  "strongs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["strongNumber", "strongRaw"],
                      "properties": {
                        "strongNumber": { "type": "string", "pattern": "^[GH][0-9]+$" },
                        "strongRaw": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "strongNumber",
          "language",
          "lemma",
          "definition",
          "definitionLanguage",
          "translationStatus",
          "source"
        ],
        "properties": {
          "strongNumber": { "type": "string", "pattern": "^[GH][0-9]+$" },
          "language": { "type": "string", "enum": ["hebrew", "greek"] },
          "lemma": { "type": "string", "minLength": 1 },
          "transliteration": { "type": "string" },
          "pronunciation": { "type": "string" },
          "definition": { "type": "string" },
          "derivation": { "type": "string" },
          "kjvDefinition": { "type": "string" },
          "definitionLanguage": { "type": "string", "enum": ["es", "en"] },
          "translationStatus": {
            "type": "string",
            "enum": ["source", "machine", "reviewed", "fallback"]
          },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
