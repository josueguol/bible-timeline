{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auth-login-request",
  "title": "AuthLoginRequest",
  "type": "object",
  "required": ["email", "password"],
  "additionalProperties": false,
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
