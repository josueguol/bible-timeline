{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timelineId",
    "title",
    "sourceManifest",
    "bibleVersion",
    "stats",
    "verses"
  ],
  "properties": {
    "timelineId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceManifest": {
      "type": "string",
      "minLength": 1
    },
    "bibleVersion": {
      "type": "string",
      "minLength": 1
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapterEntryCount", "verseCount"],
      "properties": {
        "chapterEntryCount": { "type": "integer", "minimum": 1 },
        "verseCount": { "type": "integer", "minimum": 1 }
      }
    },
    "verses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence",
          "entryId",
          "book",
          "chapter",
          "verse",
          "ref",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3
          },
          "sequence": { "type": "integer", "minimum": 1 },
          "entryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3
          },
          "book": { "type": "string", "minLength": 1 },
          "chapter": { "type": "integer", "minimum": 1 },
          "verse": { "type": "integer", "minimum": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "text": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ok", "empty-source"]
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
