{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["timelineId", "title", "navigation", "events"],
  "properties": {
    "timelineId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootEventCount", "expansionMode", "zoomLevels"],
      "properties": {
        "rootEventCount": {
          "type": "integer",
          "minimum": 1
        },
        "expansionMode": {
          "type": "string",
          "enum": ["children"]
        },
        "zoomLevels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "label",
              "minZoomFactor",
              "maxZoomFactor",
              "targetVisibleEvents",
              "description"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "minZoomFactor": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "maxZoomFactor": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "targetVisibleEvents": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/event"
      }
    }
  },
  "definitions": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentId",
        "zoomLevel",
        "sequence",
        "title",
        "startLabel",
        "endLabel",
        "summary",
        "importance",
        "canonical",
        "scriptureRefs",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 3
        },
        "parentId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "zoomLevel": {
          "type": "integer",
          "minimum": 0
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startLabel": {
          "type": "string",
          "minLength": 1
        },
        "endLabel": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "startRef": {
          "type": "string",
          "minLength": 1
        },
        "endRef": {
          "type": "string",
          "minLength": 1
        },
        "startSequence": {
          "type": "integer",
          "minimum": 1
        },
        "endSequence": {
          "type": "integer",
          "minimum": 1
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "canonical": {
          "type": "boolean"
        },
        "scriptureRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/event"
          }
        }
      }
    }
  }
}
