{
  "type": "object",
  "required": ["timelineId", "zoomLevel", "focus", "visibleEvents", "stats"],
  "properties": {
    "timelineId": {
      "type": "string",
      "minLength": 1
    },
    "zoomLevel": {
      "type": "object",
      "required": [
        "level",
        "label",
        "minZoomFactor",
        "maxZoomFactor",
        "targetVisibleEvents",
        "description"
      ],
      "properties": {
        "level": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "minZoomFactor": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxZoomFactor": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetVisibleEvents": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "required": [
        "resolvedFocusSequence",
        "focusedEventId",
        "focusPath"
      ],
      "properties": {
        "requestedFocusSequence": { "type": ["integer", "null"], "minimum": 1 },
        "requestedFocusRef": { "type": ["string", "null"] },
        "requestedFocusEventId": { "type": ["string", "null"] },
        "resolvedFocusSequence": { "type": "integer", "minimum": 1 },
        "resolvedFocusRef": { "type": ["string", "null"] },
        "focusedEventId": { "type": "string", "minLength": 1 },
        "focusPath": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "visibleEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parentId",
          "zoomLevel",
          "sequence",
          "title",
          "startSequence",
          "endSequence",
          "state",
          "isFocused",
          "isFocusAncestor",
          "displayOrder",
          "path"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "parentId": { "type": ["string", "null"] },
          "zoomLevel": { "type": "integer", "minimum": 0 },
          "sequence": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "startSequence": { "type": "integer", "minimum": 1 },
          "endSequence": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "enum": ["expanded", "collapsed"] },
          "isFocused": { "type": "boolean" },
          "isFocusAncestor": { "type": "boolean" },
          "displayOrder": { "type": "integer", "minimum": 1 },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "stats": {
      "type": "object",
      "required": ["visibleCount", "targetVisibleEvents", "viewportEventBudget"],
      "properties": {
        "visibleCount": { "type": "integer", "minimum": 1 },
        "targetVisibleEvents": { "type": "integer", "minimum": 1 },
        "viewportEventBudget": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
