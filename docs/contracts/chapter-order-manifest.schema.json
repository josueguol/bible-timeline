{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "title",
    "source",
    "normalizationAliases",
    "stats",
    "entries"
  ],
  "properties": {
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readingFile", "bibleXmlFile", "bibleVersion"],
      "properties": {
        "readingFile": { "type": "string", "minLength": 1 },
        "bibleXmlFile": { "type": "string", "minLength": 1 },
        "bibleVersion": { "type": "string", "minLength": 1 }
      }
    },
    "normalizationAliases": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLineCount",
        "xmlChapterCount",
        "resolvedEntryCount",
        "unresolvedEntryCount"
      ],
      "properties": {
        "sourceLineCount": { "type": "integer", "minimum": 0 },
        "xmlChapterCount": { "type": "integer", "minimum": 1 },
        "resolvedEntryCount": { "type": "integer", "minimum": 0 },
        "unresolvedEntryCount": { "type": "integer", "minimum": 0 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sequence",
          "sourceText",
          "bookInput",
          "chapter",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3
          },
          "sequence": { "type": "integer", "minimum": 1 },
          "sourceText": { "type": "string", "minLength": 1 },
          "bookInput": { "type": "string", "minLength": 1 },
          "bookCanonical": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "chapter": { "type": "integer", "minimum": 1 },
          "chapterRefCanonical": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "verseCount": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["ok", "alias-resolved", "unresolved"]
          },
          "notes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
