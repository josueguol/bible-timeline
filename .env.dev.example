# Stack de integración local. Solo el gateway se publica en el host.
HOST_BIND=127.0.0.1
GATEWAY_PORT=7410
ADMIN_GATEWAY_PORT=7411
CADDY_CONFIG=dev

POSTGRES_DB=bible_timeline_dev
POSTGRES_USER=bible_timeline
POSTGRES_PASSWORD=bible-timeline-dev-postgres-password

ASPNETCORE_ENV=Development
ADMIN_JWT_SECRET=bible-timeline-dev-admin-secret-change-before-sharing
NOTES_JWT_SECRET=bible-timeline-dev-notes-secret-change-before-sharing
ADMIN_SETUP_ENABLED=true
ADMIN_SETUP_TOKEN=bible-timeline-dev-setup-token
SEED_DEVELOPMENT_ADMIN=true

# Desarrollo usa localhost y dos puertos; los nombres solo se exigen para conservar
# la misma forma de configuración que producción.
PUBLIC_WEB_HOST=localhost
API_HOST=localhost
NOTES_API_HOST=localhost
CONTENT_API_HOST=localhost
ADMIN_WEB_HOST=localhost
ADMIN_API_HOST=localhost
FRONTEND_BASE_URL=http://localhost:7410
CONTENT_API_ALLOWED_ORIGINS=http://localhost:7410,http://localhost:7411
CONTENT_ADMIN_ALLOWED_ORIGINS=http://localhost:7411

GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
